{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Checker",
  "version": "0.1.0",
  "identifier": "com.pcchecker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PC Checker - Hardware Diagnostics & Health Suite",
        "width": 1150,
        "height": 780,
        "minWidth": 950,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://1.1.1.1; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCQ0M5MUEyMzlCNDJDNjQKUldSa0xMUTVvcEhNbTlGUUJZU2d0am1aazdjOStscEpuWlU3dHBGMWZmMkF4VTd3ZC9KT3VuMS8K",
      "endpoints": [
        "https://github.com/lucius02/pc-checker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
